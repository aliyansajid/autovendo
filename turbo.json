{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APP_NAME",
    "APP_DIR",
    "PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "REDIS_AUTH_URL",
    "ALLOWED_ORIGINS",

    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "APPLE_APP_BUNDLE_IDENTIFIER",
    "APPLE_CLIENT_ID",
    "APPLE_KEY_ID",
    "APPLE_PRIVATE_KEY",
    "APPLE_TEAM_ID",
    "GOOGLE_ANDROID_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_IOS_CLIENT_ID",
    "GOOGLE_WEB_CLIENT_ID",

    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_LISTING_STANDARD_PRICE_ID",
    "STRIPE_LISTING_WEBHOOK_SECRET",

    "EMAIL_HOST",
    "EMAIL_PORT",
    "EMAIL_USER",
    "EMAIL_PASS",
    "EMAIL_FROM",

    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_ACCOUNT_ID",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_DOMAIN",
    "R2_ENDPOINT",

    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_R2_PUBLIC_DOMAIN",
    "NEXT_PUBLIC_GOOGLE_MAPS_KEY",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_AUTH_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}
